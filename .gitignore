*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
# Any module's build directory, not just the root's. Each module used to carry its own .gitignore
# saying `/build`; the desktop port's was deleted along with the rest of its duplicated build
# plumbing when the two repositories were merged, and :shared never had one — so 1662 files of
# build output, 4.8 MB, were committed before anything noticed. One rule here covers every module,
# including the next one.
build/
# Where the Kotlin compiler leaves its own working files and the odd error log. Appeared the first
# time an incremental build tripped over a file that had moved between modules; it is build output
# like any other, and the rule above does not cover it because the directory is not called build.
.kotlin/
/captures
.externalNativeBuild
.cxx
local.properties

# CLAP weights, ~390 MB. They were committed once and made the repository 470 MB; the app
# downloads them from Hugging Face on demand and checks them by sha256, and a build that wants
# them bundled reads them straight from here.
app/src/main/assets/*.onnx

# IDE state that describes this machine rather than the project.
/.idea/artifacts/
/.idea/deploymentTargetSelector.xml
/.idea/deviceManager.xml

# JVM crash dumps.
hs_err_pid*.log

# Signing key and its passwords. Never commit these: the key cannot be replaced once published,
# because Android only accepts updates signed with the same one.
keystore.properties
*.jks
*.keystore
