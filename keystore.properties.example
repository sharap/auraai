# Copy to keystore.properties and fill in. That file is ignored by git on purpose.
# Values are taken literally — no quotes, and a backslash is just a backslash — but they must not
# begin or end with a space.
#
# Create the key with:
#   keytool -genkeypair -v -keystore ~/auraai-release.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias auraai
#
# Keep the key and a copy of it somewhere safe: Android only accepts an update signed with the
# same key, so losing it means no more updates for anyone who installed the app.
storeFile=/home/user/auraai-release.jks
storePassword=
keyAlias=auraai
keyPassword=
